# --- LLM: Gemini (default when GEMINI_API_KEY is set) or Anthropic ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EXTRACT_MODEL=              # optional cheaper model for extraction
# GEMINI_FALLBACK_MODEL=gemini-3.7-flash   # used on retries when the main model is busy
# LLM_PROVIDER=gemini                # force gemini or anthropic
ANTHROPIC_API_KEY=
OUTREACH_MODEL=claude-opus-5-5      # qualification, pain points, drafting
EXTRACT_MODEL=claude-haiku-5-5      # fact extraction from cleaned pages (L4: cheap model)

# --- Hunter.io (step 4) ---
HUNTER_API_KEY=

# --- Gmail (step 7) ---
# oauth = Gmail API with secrets/credentials.json (recommended)
# smtp  = Gmail SMTP with an app password (fallback if your Workspace blocks OAuth)
GMAIL_MODE=oauth
GMAIL_SENDER=
GMAIL_APP_PASSWORD=

# --- Pipeline knobs ---
AGENT_MAX_ROUNDS=4                   # max page fetches beyond the homepage (L4 slide 40)
JINA_FALLBACK=true                   # re-read thin (<200 words) pages through Jina Reader
SCRAPE_DELAY_SECONDS=1.0

# --- Storage / web ---
# DATABASE_URL=postgres://...        # Neon; set automatically by the Vercel integration
# APP_PASSWORD=                      # optional: locks the web dashboard
REVIEW_BEFORE_SEND=false
